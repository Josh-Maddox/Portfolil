						color: #aeb4bc;
						}



						/* =====================================================
						DEVELOPMENT / QA
						===================================================== */

						.work-grid {
						display: grid;

						grid-template-columns:
						repeat(
						2,
						1fr
						);

						gap: 18px;
						}


						.work-box {
						padding: 22px;

						background:
						rgba(
