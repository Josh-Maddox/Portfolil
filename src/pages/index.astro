<!DOCTYPE html>
<html lang="en">

	<head>
		<meta charset="UTF-8">

			<meta
				name="viewport"
				content="width=device-width, initial-scale=1.0"
    >

				<meta
					name="description"
					content="Josh Maddox - Game Programmer and QA Engineer portfolio."
    >

					<title>Josh Maddox | Game Programmer & QA Engineer</title>


					<style>

						/* =====================================================
						BASIC
						===================================================== */

						* {
						box-sizing: border-box;
						margin: 0;
						padding: 0;
						}


						html {
						scroll-behavior: smooth;
						}


						body {
						min-height: 100vh;

						background:
						linear-gradient(
						180deg,
						#07090c 0%,
						#090b0f 45%,
						#07090c 100%
						);

						color: #f2f2f2;

						font-family:
						Arial,
						Helvetica,
						sans-serif;

						line-height: 1.6;

						overflow-x: hidden;
						}


						a {
						color: inherit;
						text-decoration: none;
						}


						button {
						font: inherit;
						}



						/* =====================================================
						CSS-ONLY FALLING STAR BACKGROUND
						===================================================== */

						#stars {
						position: fixed;

						top: 0;
						left: 0;

						width: 100vw;
						height: 100vh;

						pointer-events: none;

						overflow: hidden;

						z-index: 0;
						}


						/*
						LARGE / BRIGHTER STAR LAYER
						*/

						#stars::before {
						content: "";

						position: absolute;

						top: -1000px;
						left: 0;

						width: 100%;
						height: calc(100% + 1000px);

						background-image:
						radial-gradient(
						circle,
						rgba(255, 255, 255, 0.95) 1.5px,
						transparent 2px
						),

						radial-gradient(
						circle,
						rgba(255, 255, 255, 0.75) 1px,
						transparent 1.7px
						);

						background-size:
						110px 110px,
						170px 170px;

						background-position:
						15px 20px,
						60px 75px;

						animation:
						starsFallLarge 18s linear infinite;
						}


						/*
						SMALLER / DIMMER STAR LAYER
						*/

						#stars::after {
						content: "";

						position: absolute;

						top: -1200px;
						left: 0;

						width: 100%;
						height: calc(100% + 1200px);

						background-image:
						radial-gradient(
						circle,
						rgba(255, 255, 255, 0.55) 1px,
						transparent 1.5px
						),

						radial-gradient(
						circle,
						rgba(255, 255, 255, 0.35) 1px,
						transparent 1.4px
						);

						background-size:
						75px 75px,
						135px 135px;

						background-position:
						30px 45px,
						80px 20px;

						animation:
						starsFallSmall 26s linear infinite;
						}


						@keyframes starsFallLarge {

						from {
						transform:
						translateY(0);
						}

						to {
						transform:
						translateY(1000px);
						}

						}


						@keyframes starsFallSmall {

						from {
						transform:
						translateY(0);
						}

						to {
						transform:
						translateY(1200px);
						}

						}



						/* =====================================================
						KEEP WEBSITE CONTENT ABOVE STARS
						===================================================== */

						header,
						main,
						footer {
						position: relative;

						z-index: 1;
						}



						/* =====================================================
						NAVIGATION
						===================================================== */

						header {
						position: sticky;

						top: 0;

						z-index: 100;

						background:
						rgba(
						8,
						10,
						13,
						0.90
						);

						border-bottom:
						1px solid #24282f;

						backdrop-filter:
						blur(10px);
						}


						nav {
						width: 90%;

						max-width: 1100px;

						min-height: 70px;

						margin: auto;

						display: flex;

						align-items: center;

						justify-content: space-between;
						}


						.logo {
						font-size: 20px;

						font-weight: bold;
						}


						.nav-links {
						display: flex;

						gap: 25px;
						}


						.nav-links a {
						color: #a8adb5;

						font-size: 14px;
						}


						.nav-links a:hover {
						color: white;
						}



						/* =====================================================
						MAIN
						===================================================== */

						main {
						width: 90%;

						max-width: 1100px;

						margin: auto;
						}



						/* =====================================================
						HOME
						===================================================== */

						.hero {
						min-height:
						calc(
						100vh - 70px
						);

						display: flex;

						flex-direction: column;

						justify-content: center;
						}


						.hero-label {
						margin-bottom: 15px;

						color: #8d949e;

						font-size: 13px;

						font-weight: bold;

						letter-spacing: 4px;
						}


						.hero h1 {
						margin-bottom: 20px;

						font-size:
						clamp(
						60px,
						10vw,
						110px
						);

						line-height: 0.95;

						letter-spacing: -3px;
						}


						.hero h2 {
						margin-bottom: 25px;

						color: #b8bdc5;

						font-size:
						clamp(
						25px,
						4vw,
						35px
						);

						font-weight: normal;
						}


						.hero-description {
						max-width: 760px;

						color: #a6abb3;

						font-size: 18px;
						}


						.hero-buttons {
						display: flex;

						gap: 15px;

						margin-top: 35px;
						}


						.button {
						display: inline-block;

						padding:
						12px 22px;

						border-radius: 5px;

						font-weight: bold;

						transition:
						transform 0.2s,
						background 0.2s;
						}


						.button:hover {
						transform:
						translateY(-2px);
						}


						.primary-button {
						background: white;

						color: #080a0d;
						}


						.primary-button:hover {
						background: #d8d8d8;
						}


						.secondary-button {
						background:
						rgba(
						21,
						24,
						29,
						0.90
						);

						border:
						1px solid #383d45;
						}


						.secondary-button:hover {
						background: #20242b;
						}



						/* =====================================================
						PROJECT SECTION
						===================================================== */

						#projects {
						padding:
						100px 0 120px;
						}


						.section-label {
						margin-bottom: 10px;

						color: #858c96;

						font-size: 12px;

						font-weight: bold;

						letter-spacing: 4px;
						}


						.section-title {
						margin-bottom: 15px;

						font-size:
						clamp(
						38px,
						6vw,
						55px
						);
						}


						.section-description {
						max-width: 700px;

						margin-bottom: 45px;

						color: #9fa5ae;
						}



						/* =====================================================
						PROJECT CARDS
						===================================================== */

						.project-grid {
						display: grid;

						grid-template-columns:
						repeat(
						3,
						1fr
						);

						gap: 22px;

						margin-bottom: 35px;
						}


						.project-card {
						display: flex;

						flex-direction: column;

						min-height: 295px;

						background:
						rgba(
						18,
						21,
						26,
						0.92
						);

						border:
						1px solid #2b3038;

						border-radius: 8px;

						overflow: hidden;

						transition:
						border-color 0.2s,
						transform 0.2s;
						}


						.project-card:hover {
						border-color: #525a66;

						transform:
						translateY(-3px);
						}


						.project-card.active {
						border-color: #89919d;
						}


						.project-main {
						flex: 1;

						padding: 25px;
						}


						.project-engine {
						margin-bottom: 8px;

						color: #7f8791;

						font-size: 11px;

						font-weight: bold;

						letter-spacing: 2px;
						}


						.project-main h3 {
						margin-bottom: 5px;

						font-size: 26px;
						}


						.project-tech {
						margin-bottom: 15px;

						color: #828994;

						font-size: 13px;
						}


						.project-description {
						color: #b5bac1;

						font-size: 15px;
						}


						.view-project {
						width: 100%;

						padding:
						16px 22px;

						border: none;

						border-top:
						1px solid #2b3038;

						background: #13161b;

						color: #eeeeee;

						cursor: pointer;

						text-align: left;

						font-weight: bold;
						}


						.view-project::after {
						content: "→";

						float: right;

						color: #828994;
						}


						.view-project:hover {
						background: #1a1e24;
						}


						.project-card.active
						.view-project {
						background: #1c2026;
						}



						/* =====================================================
						SHARED PROJECT AREA
						===================================================== */

						.project-showcase {
						width: 100%;

						min-height: 500px;

						background:
						rgba(
						13,
						16,
						20,
						0.92
						);

						border:
						1px solid #2b3038;

						border-radius: 8px;

						overflow: hidden;

						box-shadow:
