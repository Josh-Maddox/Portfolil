						border-radius: 6px;
						}


						.work-box h4 {
						margin-bottom: 8px;

						font-size: 19px;
						}


						.work-box p {
						color: #a5abb3;

						font-size: 15px;
						}



						/* =====================================================
						TOOLS
						===================================================== */

						.tags {
						display: flex;

						flex-wrap: wrap;

						gap: 9px;
						}


						.tags span {
						padding:
						7px 11px;

						background: #171a20;

						border:
						1px solid #30353d;

						border-radius: 4px;

						color: #b9bec5;

						font-size: 13px;
						}



						/* =====================================================
						VIDEO / IMAGES
						===================================================== */

						.media-layout {
						display: grid;

						grid-template-columns:
						2fr 1fr;

						gap: 18px;
						}


						.video-box {
						min-height: 360px;

						display: flex;

						align-items: center;

						justify-content: center;

						background: #101318;

						border:
						1px solid #30353d;

						border-radius: 6px;

						color: #666d76;

						text-align: center;

						overflow: hidden;
						}


						.image-column {
						display: grid;

						grid-template-rows:
						1fr 1fr;

						gap: 18px;
						}


						.image-box {
						min-height: 170px;

						display: flex;

						align-items: center;

						justify-content: center;

						background: #15181d;

						border:
						1px solid #30353d;

						border-radius: 6px;

						color: #666d76;

						text-align: center;

						overflow: hidden;
						}


						.image-box img {
						width: 100%;

						height: 100%;

						display: block;

						object-fit: cover;
						}


						.video-box video {
						width: 100%;

						height: 100%;

						display: block;

						object-fit: cover;
						}



						/* =====================================================
						CODE
						===================================================== */

						.code-box {
						overflow-x: auto;

						background: #07090c;

						border:
						1px solid #30353d;

						border-radius: 6px;
						}


						.code-title {
						padding:
						11px 15px;

						background: #171a20;

						border-bottom:
						1px solid #30353d;

						color: #9097a1;

						font-size: 13px;
						}


						pre {
						margin: 0;

						padding: 22px;

						color: #d4d8dd;
						}


						code {
						font-family:
						Consolas,
						"Courier New",
						monospace;

						font-size: 14px;
						}



						/* =====================================================
						FOOTER
						===================================================== */

						footer {
						padding:
						35px 20px;

						text-align: center;

						color: #666d76;

						border-top:
						1px solid #24282f;
						}



						/* =====================================================
						MOBILE
						===================================================== */

						@media (max-width: 850px) {

						.project-grid {
						grid-template-columns: 1fr;
						}


						.work-grid {
						grid-template-columns: 1fr;
						}


						.media-layout {
						grid-template-columns: 1fr;
						}


						.image-column {
						grid-template-columns:
						1fr 1fr;

						grid-template-rows: auto;
						}

						}


						@media (max-width: 600px) {

						.nav-links {
						display: none;
						}


						.hero h1 {
						font-size: 55px;

						letter-spacing: -2px;
						}


						.hero-buttons {
						flex-direction: column;

						align-items: flex-start;
						}


						.project-detail {
						padding: 25px;
						}


						.image-column {
						grid-template-columns: 1fr;
						}

						}

					</style>

				</head>



