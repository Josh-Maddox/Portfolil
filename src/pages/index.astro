			* {
			box-sizing: border-box;
			}


			html {
			scroll-behavior: smooth;
			}


			body {
			margin: 0;

			background: #101214;

			color: #eeeeee;

			font-family:
			Arial,
			Helvetica,
			sans-serif;

			line-height: 1.6;
			}


			main {
			width: 90%;

			max-width: 1000px;

			margin: 0 auto;

			padding: 60px 0;
			}


			h1 {
			font-size: 48px;

			margin-bottom: 5px;
			}


			h2 {
			margin-top: 0;

			color: #bbbbbb;

			font-weight: normal;
			}


			.intro {
			margin-bottom: 50px;
			}


			.intro p {
			max-width: 700px;

			color: #bbbbbb;
			}


			section {
			margin-bottom: 50px;
			}


			section > h2 {
			color: #ffffff;

			font-size: 30px;

			font-weight: bold;

			margin-bottom: 20px;
			}


			details {
			margin-bottom: 15px;

			background: #181b1f;

			border: 1px solid #30343a;

			border-radius: 6px;

			overflow: hidden;
			}


			summary {
			padding: 20px;

			cursor: pointer;

			font-size: 20px;

			font-weight: bold;
			}


			.details-content {
			padding:
			0 20px 20px;

			color: #cccccc;
			}


			.details-content h3 {
			color: #ffffff;

			margin-top: 30px;

			margin-bottom: 10px;
			}


			.details-content h4 {
			color: #ffffff;

			margin-bottom: 5px;
			}


			.details-content p {
			margin-top: 5px;
			}


			.project-info {
			color: #999999;

			font-size: 14px;
			}


			.code-box {
			margin-top: 15px;

			padding: 20px;

			background: #0b0d0f;

			border: 1px solid #30343a;

			border-radius: 5px;

			overflow-x: auto;
			}


			pre {
			margin: 0;
			}


			code {
			font-family:
			Consolas,
			"Courier New",
			monospace;

			color: #dddddd;
			}


			.image-box {
			min-height: 200px;

			margin-top: 15px;

			display: flex;

			align-items: center;

			justify-content: center;

			background: #202328;

			border: 1px solid #30343a;

			border-radius: 5px;

			color: #777777;
			}


			.tags {
			display: flex;

			flex-wrap: wrap;

			gap: 8px;

			margin-top: 10px;
			}


			.tags span {
			padding:
			6px 10px;

			background: #22262b;

			border: 1px solid #383d44;

			border-radius: 4px;

			font-size: 14px;
			}


			a {
			color: #ffffff;
			}


			footer {
			margin-top: 70px;

			padding-top: 25px;

			border-top: 1px solid #30343a;

			color: #777777;
			}


			@media (max-width: 600px) {

