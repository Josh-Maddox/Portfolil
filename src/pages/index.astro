		<!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

		<script>


			/* =====================================================
			PROJECT SWITCHING
			===================================================== */

			const projectButtons =
			document.querySelectorAll(
			".view-project"
			);


			const projectDetails =
			document.querySelectorAll(
			".project-detail"
			);


			const projectCards =
			document.querySelectorAll(
			".project-card"
			);


			projectButtons.forEach(
			button => {

			button.addEventListener(
			"click",
			() => {

			const target =
			button.dataset.target;


			const targetDetail =
			document.getElementById(
			target
			);


			const targetCard =
			document.querySelector(
			`[data-project="${target}"]`
			);


			projectDetails.forEach(
			detail => {

			detail.classList.remove(
			"active"
			);

			}
			);


			projectCards.forEach(
			card => {

			card.classList.remove(
			"active"
			);

			}
			);


			if (targetDetail) {

			targetDetail.classList.add(
			"active"
			);

			}


			if (targetCard) {

			targetCard.classList.add(
			"active"
			);

			}

			}
			);

			}
			);



			/* =====================================================
			SLOW MATRIX BACKGROUND
			===================================================== */

			const matrixCanvas =
			document.getElementById(
			"matrix-bg"
			);


			if (matrixCanvas) {

			const ctx =
			matrixCanvas.getContext(
			"2d"
			);


			const characters =
			"アァカサタナハマヤャラワ0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ#$%&*+-<>";


			const fontSize =
			18;


			let columns =
			[];


			function resizeMatrix() {

			const pixelRatio =
			window.devicePixelRatio || 1;


			matrixCanvas.width =
			Math.floor(
			window.innerWidth *
			pixelRatio
			);


			matrixCanvas.height =
			Math.floor(
			window.innerHeight *
			pixelRatio
			);


			matrixCanvas.style.width =
			window.innerWidth +
			"px";


			matrixCanvas.style.height =
			window.innerHeight +
			"px";


			ctx.setTransform(
			pixelRatio,
			0,
			0,
			pixelRatio,
			0,
			0
			);


			const columnCount =
			Math.ceil(
			window.innerWidth /
			fontSize
			);


			columns =
			[];


			for (
			let i = 0;
			i < columnCount;
                    i++
                ) {

                    const trailLength =
                        Math.floor(
                            Math.random() * 6
                        ) + 5;


                    const symbols =
                        [];


                    for (
                        let j = 0;
                        j < trailLength;
                        j++
                    ) {

                        symbols.push(
                            characters.charAt(
                                Math.floor(
                                    Math.random() *
                                    characters.length
                                )
                            )
                        );

                    }


                    columns.push({

                        y:
                            Math.random() *
                            window.innerHeight,

                        speed:
                            Math.random() *
                            0.03 +
                            0.01,

                        brightness:
                            Math.random() *
                            0.45 +
                            0.30,

                        symbols:
                            symbols,

                        lastCharacterChange:
                            performance.now(),

                        characterChangeSpeed:
                            Math.random() *
                            700 +
                            700

                    });

                }


                ctx.fillStyle =
                    "#000";


                ctx.fillRect(
                    0,
                    0,
                    window.innerWidth,
                    window.innerHeight
                );

            }



            function drawMatrix() {

                /*
                   This slightly dark transparent
                   layer creates the fading trail.
                */

                ctx.fillStyle =
                    "rgba(0, 0, 0, 0.10)";


                ctx.fillRect(
                    0,
                    0,
                    window.innerWidth,
                    window.innerHeight
                );


                ctx.font =
                    `${fontSize}px monospace`;


                ctx.textAlign =
                    "center";


                for (
                    let i = 0;
                    i < columns.length;
                    i++
                ) {

                    const column =
                        columns[i];


                    const x =
                        i * fontSize +
                        fontSize / 2;


                    const now =
                        performance.now();


                    if (
                        now -
                        column.lastCharacterChange >=
                        column.characterChangeSpeed
                    ) {

                        const characterToChange =
                            Math.floor(
                                Math.random() *
                                column.symbols.length
                            );


                        column.symbols[characterToChange] =
                            characters.charAt(
                                Math.floor(
                                    Math.random() *
                                    characters.length
                                )
                            );


                        column.lastCharacterChange =
                            now;


                        column.characterChangeSpeed =
                            Math.random() *
                            700 +
                            700;

                    }


                    for (
                        let j = 0;
                        j < column.symbols.length;
                        j++
                    ) {

                        const characterY =
                            column.y -
                            j * fontSize;


                        const fade =
                            1 -
                            (
                                j /
                                column.symbols.length
                            );


                        ctx.fillStyle =
                            `rgba(0, 255, 65, ${column.brightness * fade})`;


                        ctx.fillText(
                            column.symbols[j],
                            x,
                            characterY
                        );


                        if (
                            j === 0 &&
			Math.random() >
			0.985
			) {

			ctx.fillStyle =
			"rgba(190, 255, 205, 0.95)";


			ctx.fillText(
			column.symbols[j],
			x,
			characterY
			);

			}

			}


			/*
			Each column has its own
			random slow speed.
			*/

			column.y +=
			column.speed *
			fontSize;


			/*
			When a column reaches the bottom,
			restart it at a random point
			above the screen.
			*/

			if (
			column.y >
			window.innerHeight +
			fontSize
			) {

			column.y =
			-(
			Math.random() *
			window.innerHeight *
			0.75
			);


			column.speed =
			Math.random() *
			0.08 +
			0.003;


			column.brightness =
			Math.random() *
			0.45 +
			0.30;

			}

			}


			requestAnimationFrame(
			drawMatrix
			);

			}



			resizeMatrix();


			window.addEventListener(
			"resize",
			resizeMatrix
			);


			requestAnimationFrame(
			drawMatrix
			);

			}


		</script>


	</body>

