		<!-- =========================================================
	     INLINE JAVASCRIPT
	========================================================= -->

		<script is:inline="">

			const starBackground =
			document.getElementById(
			"star-background"
			);


			if (starBackground) {

			const starCount =
			85;


			for (
			let i = 0;
			i < starCount;
				i++
			) {

				const star =
					document.createElement(
						"span"
					);


				star.className =
					"star";


				const size =
					Math.random() * 2 + 0.7;


				star.style.width =
					`${size}px`;


				star.style.height =
					`${size}px`;


				star.style.left =
					`${Math.random() * 100}%`;


				star.style.animationDuration =
					`${Math.random() * 18 + 14}s`;


				star.style.animationDelay =
					`${Math.random() * -35}s`;


				star.style.setProperty(
					"--star-opacity",
					`${Math.random() * 0.38 + 0.08}`
				);


				starBackground.appendChild(
					star
				);

			}

		}



		/* Close other projects when a new one opens */

		const projects =
			document.querySelectorAll(
				".project-card"
			);


		projects.forEach(
			(project) => {

				project.addEventListener(
					"toggle",
					() => {

						if (project.open) {

							projects.forEach(
								(otherProject) => {

									if (
										otherProject !== project
									) {

										otherProject.open =
											false;

									}

								}
							);

						}

					}
				);

			}
		);

		</script>


