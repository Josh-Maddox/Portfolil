<!DOCTYPE html>
<html lang="en">

	<head>
		<meta charset="UTF-8">

			<meta
				name="viewport"
				content="width=device-width, initial-scale=1.0"
    >

				<meta
					name="description"
					content="Josh Maddox - Game Programmer and QA Engineer portfolio."
    >

					<title>
						Josh Maddox | Game Programmer & QA Engineer
					</title>


					<style>

						/* =====================================================
						BASIC
						===================================================== */

						* {
						box-sizing: border-box;
						margin: 0;
						padding: 0;
						}


						html {
						scroll-behavior: smooth;
						}


						body {
						min-height: 100vh;

						background: #000;

						color: #f2f2f2;

						font-family:
						Arial,
						Helvetica,
						sans-serif;

						line-height: 1.6;

						overflow-x: hidden;
						}


						a {
						color: inherit;
						text-decoration: none;
						}


						button {
						font: inherit;
						}



						/* =====================================================
						MATRIX BACKGROUND
						===================================================== */

						#matrix-bg {
						position: fixed;

						top: 0;
						left: 0;

						width: 100vw;
						height: 100vh;

						pointer-events: none;

						z-index: 0;

						background: #000;
						}



						/* =====================================================
						KEEP WEBSITE ABOVE MATRIX
						===================================================== */

						header,
						main,
						footer {
						position: relative;

						z-index: 2;
						}



						/* =====================================================
						NAVIGATION
						===================================================== */

						header {
						position: sticky;

						top: 0;

						z-index: 100;

						background:
						rgba(
						8,
						10,
						13,
						0.90
						);

						border-bottom:
						1px solid #24282f;

						backdrop-filter:
						blur(10px);
						}


						nav {
						width: 90%;

						max-width: 1100px;

						min-height: 70px;

						margin: auto;

						display: flex;

						align-items: center;

						justify-content: space-between;
						}


						.logo {
						font-size: 20px;

						font-weight: bold;
						}


						.nav-links {
						display: flex;

						gap: 25px;
						}


						.nav-links a {
						color: #a8adb5;

						font-size: 14px;
						}


						.nav-links a:hover {
						color: white;
						}



						/* =====================================================
						MAIN
						===================================================== */

						main {
						width: 90%;

						max-width: 1100px;

						margin: auto;
						}



						/* =====================================================
						HOME
						===================================================== */

						.hero {
						min-height:
						calc(
						100vh - 70px
						);

						display: flex;

						flex-direction: column;

						justify-content: center;
						}


						.hero-label {
						margin-bottom: 15px;

						color: #8d949e;

						font-size: 13px;

						font-weight: bold;

						letter-spacing: 4px;
						}


						.hero h1 {
						margin-bottom: 20px;

						font-size:
						clamp(
						60px,
						10vw,
						110px
						);

						line-height: 0.95;

						letter-spacing: -3px;
						}


						.hero h2 {
						margin-bottom: 25px;

						color: #b8bdc5;

						font-size:
						clamp(
						25px,
						4vw,
						35px
						);

						font-weight: normal;
						}


						.hero-description {
						max-width: 760px;

						color: #a6abb3;

						font-size: 18px;
						}


						.hero-buttons {
						display: flex;

						gap: 15px;

						margin-top: 35px;
						}


						.button {
						display: inline-block;

						padding:
						12px 22px;

						border-radius: 5px;

						font-weight: bold;

						transition:
						transform 0.2s,
						background 0.2s;
						}


						.button:hover {
						transform:
						translateY(-2px);
						}


						.primary-button {
						background: white;

						color: #080a0d;
						}


						.primary-button:hover {
						background: #d8d8d8;
						}


						.secondary-button {
						background:
						rgba(
						21,
						24,
						29,
						0.90
						);

						border:
						1px solid #383d45;
						}


						.secondary-button:hover {
						background: #20242b;
						}



						/* =====================================================
						PROJECT SECTION
						===================================================== */

						#projects {
						padding:
						100px 0 120px;
						}


						.section-label {
						margin-bottom: 10px;

						color: #858c96;

						font-size: 12px;

						font-weight: bold;

						letter-spacing: 4px;
						}


						.section-title {
						margin-bottom: 15px;

						font-size:
						clamp(
						38px,
						6vw,
						55px
						);
						}


						.section-description {
						max-width: 700px;

						margin-bottom: 45px;

						color: #9fa5ae;
						}



						/* =====================================================
						PROJECT CARDS
						===================================================== */

						.project-grid {
						display: grid;

						grid-template-columns:
						repeat(
						3,
						1fr
						);

						gap: 22px;

						margin-bottom: 35px;
						}


						.project-card {
						display: flex;

						flex-direction: column;

						min-height: 295px;

						background:
						rgba(
						18,
						21,
						26,
						0.92
						);

						border:
						1px solid #2b3038;

						border-radius: 8px;

						overflow: hidden;

						transition:
						border-color 0.2s,
						transform 0.2s;
						}


						.project-card:hover {
						border-color: #525a66;

						transform:
						translateY(-3px);
						}


						.project-card.active {
						border-color: #89919d;
						}


						.project-main {
						flex: 1;

						padding: 25px;
						}


						.project-engine {
						margin-bottom: 8px;

						color: #7f8791;

						font-size: 11px;

						font-weight: bold;

						letter-spacing: 2px;
						}


						.project-main h3 {
						margin-bottom: 5px;

						font-size: 26px;
						}


						.project-tech {
						margin-bottom: 15px;

						color: #828994;

						font-size: 13px;
						}


						.project-description {
						color: #b5bac1;

						font-size: 15px;
						}


						.view-project {
						width: 100%;

						padding:
						16px 22px;

						border: none;

						border-top:
						1px solid #2b3038;

						background: #13161b;

						color: #eeeeee;

						cursor: pointer;

						text-align: left;

						font-weight: bold;
						}


						.view-project::after {
						content: "→";

						float: right;

						color: #828994;
						}


						.view-project:hover {
						background: #1a1e24;
						}


						.project-card.active
						.view-project {
						background: #1c2026;
						}



						/* =====================================================
						SHARED PROJECT AREA
						===================================================== */

						.project-showcase {
						width: 100%;

						min-height: 500px;

						background:
						rgba(
						13,
						16,
						20,
						0.92
						);

						border:
						1px solid #2b3038;

						border-radius: 8px;

						overflow: hidden;

						box-shadow:
						0 20px 60px
						rgba(
						0,
						0,
						0,
						0.25
						);
						}


						.project-detail {
						display: none;

						padding: 45px;
						}


						.project-detail.active {
						display: block;
						}



						/* =====================================================
						PROJECT HEADER
						===================================================== */

						.detail-top {
						margin-bottom: 45px;
						}


						.detail-engine {
						margin-bottom: 8px;

						color: #858c96;

						font-size: 12px;

						font-weight: bold;

						letter-spacing: 3px;
						}


						.detail-top h2 {
						margin-bottom: 12px;

						font-size:
						clamp(
						36px,
						6vw,
						55px
						);
						}


						.detail-top p {
						max-width: 850px;

						color: #aeb4bc;
						}



						/* =====================================================
						PROJECT SECTIONS
						===================================================== */

						.detail-section {
						margin-top: 50px;
						}


						.detail-section h3 {
						margin-bottom: 18px;

						font-size: 26px;
						}


						.detail-section > p {
						max-width: 850px;

						color: #aeb4bc;
						}



						/* =====================================================
						DEVELOPMENT / QA
						===================================================== */

						.work-grid {
						display: grid;

						grid-template-columns:
						repeat(
						2,
						1fr
						);

						gap: 18px;
						}


						.work-box {
						padding: 22px;

						background:
						rgba(
						21,
						24,
						29,
						0.90
						);

						border:
						1px solid #2c3139;

						border-radius: 6px;
						}


						.work-box h4 {
						margin-bottom: 8px;

						font-size: 19px;
						}


						.work-box p {
						color: #a5abb3;

						font-size: 15px;
						}



						/* =====================================================
						TOOLS
						===================================================== */

						.tags {
						display: flex;

						flex-wrap: wrap;

						gap: 9px;
						}


						.tags span {
						padding:
						7px 11px;

						background: #171a20;

						border:
						1px solid #30353d;

						border-radius: 4px;

						color: #b9bec5;

						font-size: 13px;
						}



						/* =====================================================
						VIDEO / IMAGES
						===================================================== */

						.media-layout {
						display: grid;

						grid-template-columns:
						2fr 1fr;

						gap: 18px;
						}


						.video-box {
						min-height: 360px;

						display: flex;

						align-items: center;

						justify-content: center;

						background: #101318;

						border:
						1px solid #30353d;

						border-radius: 6px;

						color: #666d76;

						text-align: center;

						overflow: hidden;
						}


						.image-column {
						display: grid;

						grid-template-rows:
						1fr 1fr;

						gap: 18px;
						}


						.image-box {
						min-height: 170px;

						display: flex;

						align-items: center;

						justify-content: center;

						background: #15181d;

						border:
						1px solid #30353d;

						border-radius: 6px;

						color: #666d76;

						text-align: center;

						overflow: hidden;
						}


						.image-box img,
						.video-box video {
						width: 100%;

						height: 100%;

						display: block;

						object-fit: cover;
						}



						/* =====================================================
						CODE
						===================================================== */

						.code-box {
						overflow-x: auto;

						background: #07090c;

						border:
						1px solid #30353d;

						border-radius: 6px;
						}


						.code-title {
						padding:
						11px 15px;

						background: #171a20;

						border-bottom:
						1px solid #30353d;

						color: #9097a1;

						font-size: 13px;
						}


						pre {
						margin: 0;

						padding: 22px;

						color: #d4d8dd;
						}


						code {
						font-family:
						Consolas,
						"Courier New",
						monospace;

						font-size: 14px;
						}



						/* =====================================================
						FOOTER
						===================================================== */

						footer {
						padding:
						35px 20px;

						text-align: center;

						color: #666d76;

						border-top:
						1px solid #24282f;
						}



						/* =====================================================
						MOBILE
						===================================================== */

						@media (max-width: 850px) {

						.project-grid {
						grid-template-columns: 1fr;
						}


						.work-grid {
						grid-template-columns: 1fr;
						}


						.media-layout {
						grid-template-columns: 1fr;
						}


						.image-column {
						grid-template-columns:
						1fr 1fr;

						grid-template-rows: auto;
						}

						}


						@media (max-width: 600px) {

						.nav-links {
						display: none;
						}


						.hero h1 {
						font-size: 55px;

						letter-spacing: -2px;
						}


						.hero-buttons {
						flex-direction: column;

						align-items: flex-start;
						}


						.project-detail {
						padding: 25px;
						}


						.image-column {
						grid-template-columns: 1fr;
						}

						}

					</style>

				</head>



