			/* ================================================= */
			/* STARS                                             */
			/* ================================================= */

			.star-background {
			position: fixed;

			top: 0;

			left: 0;

			width: 100%;

			height: 100%;

			overflow: hidden;

			pointer-events: none;

			z-index: 0;
			}



			.star {
			position: absolute;

			top: -20px;

			background: white;

			border-radius: 50%;

			opacity: 0;

			box-shadow:
			0 0 4px
			rgba(
			255,
			255,
			255,
			0.35
			);

			animation:
			fall linear infinite;
			}



			@keyframes fall {

			0% {
			transform:
			translateY(-30px);

			opacity: 0;
			}


			10% {
			opacity:
			var(--star-opacity);
			}


			80% {
			opacity:
			var(--star-opacity);
			}


			100% {
			transform:
			translateY(105vh);

			opacity: 0;
			}

			}



			header,
			main,
			footer {
			position: relative;

			z-index: 1;
			}



