				</div>

			</section>


		</main>



		<footer>

			© 2026 Josh Maddox

		</footer>



		<!-- =====================================================
         STAR BACKGROUND SCRIPT
    ====================================================== -->

		<script>

			const stars =
			document.getElementById(
			"stars"
			);


			for (
			let i = 0;
			i < 80;
            i++
        ) {

            const star =
                document.createElement(
                    "span"
                );


            star.className =
                "star";


            const size =
                Math.random() * 2 + 1;


            star.style.width =
                size + "px";


            star.style.height =
                size + "px";


            star.style.left =
                Math.random() * 100 + "%";


            star.style.animationDuration =
                Math.random() * 15 + 15 + "s";


            star.style.animationDelay =
                Math.random() * -30 + "s";


            star.style.setProperty(
                "--opacity",
                Math.random() * 0.35 + 0.08
            );


            stars.appendChild(
                star
            );

        }

		</script>


	</body>

</html>