			text-decoration: none;

			transition:
				transform 0.2s,
				background 0.2s;
		}


		.button:hover {
			transform:
				translateY(-2px);
		}


		.primary {
			background: white;
			color: black;
		}


		.primary:hover {
			background: #d8d8d8;
		}


		.secondary {
			background:
				rgba(
					20,
					23,
					28,
					0.8
				);

			border:
				1px solid #424750;

			color: white;
		}


		.secondary:hover {
			background: #20242b;
		}



		/* ===================================================== */
		/* PROJECT LIST                                         */
		/* ===================================================== */

		.project-list {
			display: flex;

			flex-direction: column;

			gap: 30px;
		}


		.project-card {
			background:
				rgba(
					17,
					20,
					25,
					0.94
				);

			border:
				1px solid #2d323a;

			border-radius: 10px;

			overflow: hidden;

			transition:
				border-color 0.2s,
				transform 0.2s;
		}


		.project-card:hover {
			border-color: #535a65;
		}


		.project-card[open] {
			border-color: #676f7c;
		}


		.project-summary {
			display: grid;

			grid-template-columns:
				minmax(280px, 430px)
				1fr;

			gap: 35px;

			padding: 25px;

			cursor: pointer;

			list-style: none;
		}


		.project-summary::-webkit-details-marker {
			display: none;
		}


		.project-summary::marker {
			display: none;
		}


		.project-preview-image {
			min-height: 260px;

			background: #20242b;

			border:
				1px solid #2d323a;

			border-radius: 7px;

			display: flex;

			align-items: center;

			justify-content: center;

			color: #777e87;

			text-align: center;
		}


		.project-preview-content {
			display: flex;

			flex-direction: column;

			justify-content: center;
		}


		.project-preview-content h3 {
			font-size:
				clamp(
					30px,
					5vw,
					44px
				);

			margin-bottom: 4px;
		}


		.project-tech {
			color: #858b94;

			font-size: 14px;

			margin-bottom: 20px;
		}


		.project-short-description {
			max-width: 650px;

			color: #c3c6ca;

			font-size: 17px;
		}


		.project-toggle {
			margin-top: 25px;

			font-weight: bold;

			color: white;
		}


		.collapse-text {
			display: none;
		}


		.project-card[open]
		.view-text {
			display: none;
		}


		.project-card[open]
		.collapse-text {
			display: inline;
		}



		/* ===================================================== */
		/* EXPANDED PROJECT                                     */
		/* ===================================================== */

		.project-expanded {
			padding:
				20px
				45px
				60px;

			border-top:
				1px solid #292e35;

			animation:
				projectOpen
				0.3s
				ease;
		}


		@keyframes projectOpen {

			from {
				opacity: 0;

				transform:
					translateY(-10px);
			}

			to {
				opacity: 1;

				transform:
					translateY(0);
			}

		}


		.expanded-heading {
			padding-top: 45px;
		}


		.expanded-heading h2 {
			font-size:
				clamp(
					42px,
					7vw,
					70px
				);

			line-height: 1;

			margin-bottom: 20px;
		}


		.expanded-heading > p:last-child {
			max-width: 800px;

			font-size: 18px;

			color: #b7bbc1;
		}


		.large-media {
			height: 500px;

			margin: 45px 0;

			background: #20242b;

			border:
				1px solid #30363f;

			border-radius: 8px;

			display: flex;

			align-items: center;

			justify-content: center;

			color: #777e87;

			text-align: center;
		}


		.project-section {
			margin-top: 55px;
		}


		.project-section > h3 {
			font-size: 30px;

			margin-bottom: 20px;
		}


		.project-section > p {
			max-width: 850px;

			color: #b7bbc1;

			font-size: 17px;

			margin-bottom: 15px;
		}



		/* ===================================================== */
		/* CONTRIBUTION CARDS                                   */
		/* ===================================================== */

		.contribution-grid {
			display: grid;

			grid-template-columns:
				repeat(
					2,
					1fr
				);

			gap: 18px;
		}


		.contribution-card {
			padding: 25px;

			background: #171a20;

			border:
				1px solid #2e333b;

			border-radius: 8px;
		}


		.contribution-card h4 {
			font-size: 20px;

			margin-bottom: 10px;
		}


		.contribution-card p {
			color: #9da3ab;
		}



		/* ===================================================== */
		/* TAGS                                                 */
		/* ===================================================== */

		.tag-list {
			display: flex;

			flex-wrap: wrap;

			gap: 10px;
		}


		.tag-list span {
			padding: 9px 15px;

			background: #171a20;

			border:
				1px solid #303640;

			border-radius: 5px;

			color: #d2d4d7;
		}



		/* ===================================================== */
		/* MEDIA                                                */
		/* ===================================================== */

		.media-grid {
			display: grid;

			grid-template-columns:
				repeat(
					2,
					1fr
				);

			gap: 18px;
		}


		.media-box {
			height: 290px;

			background: #20242b;

			border:
				1px solid #30363f;

			border-radius: 8px;

			display: flex;

			align-items: center;

			justify-content: center;

			color: #777e87;
		}



		/* ===================================================== */
		/* SKILLS                                               */
		/* ===================================================== */

		.skills-grid {
			display: grid;

			grid-template-columns:
				repeat(
					2,
					1fr
				);

			gap: 20px;

			margin-top: 40px;
		}


		.skill-category {
			background:
				rgba(
					17,
					20,
					25,
					0.94
				);

			border:
				1px solid #2d323a;

			border-radius: 8px;

			padding: 30px;
		}


		.skill-category h3 {
			font-size: 23px;

			margin-bottom: 20px;
		}



		/* ===================================================== */
		/* ABOUT                                                */
		/* ===================================================== */

		.about-card {
			max-width: 850px;

			background:
				rgba(
					17,
					20,
					25,
					0.94
				);

			border:
				1px solid #2d323a;

			border-radius: 8px;

			padding: 35px;
		}


		.about-card p {
			font-size: 18px;

			color: #b7bbc1;

			margin-bottom: 18px;
		}


		.about-card p:last-child {
			margin-bottom: 0;
		}



		/* ===================================================== */
		/* CONTACT                                              */
		/* ===================================================== */

		.contact-card {
			display: flex;

			align-items: center;

			justify-content:
				space-between;

			gap: 30px;

			background:
				rgba(
					17,
					20,
					25,
					0.94
				);

			border:
				1px solid #2d323a;

			border-radius: 8px;

			padding: 40px;
		}


		.contact-card h3 {
			font-size: 27px;

			margin-bottom: 8px;
		}


		.contact-card p {
			color: #9da3ab;
		}



		/* ===================================================== */
		/* FOOTER                                               */
		/* ===================================================== */

		footer {
			text-align: center;

			padding: 45px;

			color: #707780;

			border-top:
				1px solid #252a31;

			background:
				rgba(
					11,
					13,
					16,
					0.75
				);
		}



		/* ===================================================== */
		/* MOBILE                                               */
		/* ===================================================== */

		@media (max-width: 850px) {

			.nav-links {
				display: none;
			}


			.hero {
				min-height: 80vh;
			}


			.project-summary {
				grid-template-columns: 1fr;
			}


			.project-preview-image {
				min-height: 230px;
			}


			.project-expanded {
				padding:
					20px
					25px
					45px;
			}


			.contribution-grid {
				grid-template-columns: 1fr;
			}


			.skills-grid {
				grid-template-columns: 1fr;
			}


			.media-grid {
				grid-template-columns: 1fr;
			}


			.large-media {
				height: 320px;
			}


			.contact-card {
				flex-direction: column;

				align-items: flex-start;
			}

		}


		@media (max-width: 500px) {

			main {
				padding:
					0 20px;
			}


			nav {
				padding:
					18px 20px;
			}


			section {
				padding:
					75px 0;
			}


			.hero h1 {
				font-size: 55px;
			}


			.hero-buttons {
				flex-direction: column;

				align-items: flex-start;
			}


			.project-summary {
				padding: 18px;
			}


			.project-expanded {
				padding:
					15px
					18px
					35px;
			}


			.large-media {
				height: 240px;
			}


			.media-box {
				height: 220px;
			}

		}

	</style>



	<!-- ===================================================== -->
	<!-- STAR SCRIPT                                           -->
	<!-- ===================================================== -->

	<script>

		const background =
			document.getElementById(
				"star-background"
			);


		if (background) {

			const numberOfStars =
				70;


			for (
				let i = 0;
				i < numberOfStars;
				i++
			) {

				const star =
					document.createElement(
						"span"
					);


				star.classList.add(
					"star"
				);


				const size =
					Math.random() * 2 + 1;


				star.style.width =
					`${size}px`;


				star.style.height =
					`${size}px`;


				star.style.left =
					`${Math.random() * 100}%`;


				star.style.animationDuration =
					`${Math.random() * 15 + 15}s`;


				star.style.animationDelay =
					`${Math.random() * -30}s`;


				star.style.setProperty(
					"--star-opacity",
					`${Math.random() * 0.30 + 0.08}`
				);


				background.appendChild(
					star
				);

			}

		}

	</script>


</body>

