<!DOCTYPE html>

<html lang="en">

	<head>

		<meta charset="UTF-8">

			<meta
				name="viewport"
				content="width=device-width, initial-scale=1.0"
    >

				<meta
					name="description"
					content="Josh Maddox - Game Programmer and QA Engineer portfolio featuring Unreal Engine, C++, Unity, C#, Godot, testing, debugging, and game development projects."
    >

					<title>
						Josh Maddox | Game Programmer & QA Engineer
					</title>


					<style>

						/* =====================================================
						BASIC PAGE
						===================================================== */

						* {
						box-sizing: border-box;
						margin: 0;
						padding: 0;
						}


						html {
						scroll-behavior: smooth;
						}


						body {
						min-height: 100vh;

						background: #080a0d;

						color: #f2f2f2;

						font-family:
						Arial,
						Helvetica,
						sans-serif;

						line-height: 1.6;

						overflow-x: hidden;
						}


						a {
						color: inherit;

						text-decoration: none;
						}



						/* =====================================================
						STAR BACKGROUND
						===================================================== */

						#stars {
						position: fixed;

						top: 0;
						left: 0;

						width: 100%;
						height: 100%;

						overflow: hidden;

						pointer-events: none;

						z-index: 0;
						}


						.star {
						position: absolute;

						top: -10px;

						background: white;

						border-radius: 50%;

						opacity: 0;

						animation:
						fall linear infinite;
						}


						@keyframes fall {

						0% {
						transform:
						translateY(-20px);

						opacity: 0;
						}


						10% {
						opacity:
						var(--opacity);
						}


						85% {
						opacity:
						var(--opacity);
						}


						100% {
						transform:
						translateY(110vh);

						opacity: 0;
						}

						}



						/* =====================================================
						PAGE CONTENT
						===================================================== */

						header,
						main,
						footer {
						position: relative;

						z-index: 1;
						}



						/* =====================================================
						NAVIGATION
						===================================================== */

						header {
						position: sticky;

						top: 0;

						z-index: 10;

						background:
						rgba(
						8,
						10,
						13,
						0.90
						);

						border-bottom:
						1px solid #24282f;

						backdrop-filter:
						blur(10px);
						}


						nav {
						width: 90%;

						max-width: 1150px;

						margin: auto;

						min-height: 70px;

						display: flex;

						align-items: center;

						justify-content: space-between;
						}


						.logo {
						font-size: 20px;

						font-weight: bold;
						}


						.nav-links {
						display: flex;

						gap: 25px;
						}


						.nav-links a {
						color: #a8adb5;

						font-size: 14px;
						}


						.nav-links a:hover {
						color: white;
						}



						/* =====================================================
						MAIN
						===================================================== */

						main {
						width: 90%;

						max-width: 1150px;

						margin: auto;
						}



						/* =====================================================
						HERO
						===================================================== */

						.hero {
						min-height:
						calc(
						100vh - 70px
						);

						display: flex;

						flex-direction: column;

						justify-content: center;
						}


						.hero-label {
						margin-bottom: 15px;

						color: #8d949e;

						font-size: 13px;

						font-weight: bold;

						letter-spacing: 4px;
						}


						.hero h1 {
						font-size:
						clamp(
						60px,
						10vw,
						110px
						);

						line-height: 0.95;

						margin-bottom: 20px;

						letter-spacing: -3px;
						}


						.hero h2 {
						margin-bottom: 25px;

						color: #b8bdc5;

						font-size:
						clamp(
						25px,
						4vw,
						35px
						);

						font-weight: normal;
						}


						.hero-description {
						max-width: 760px;

						color: #a6abb3;

						font-size: 18px;
						}


						.hero-buttons {
						display: flex;

						gap: 15px;

						margin-top: 35px;
						}


						.button {
						display: inline-block;

						padding:
						12px 22px;

						border-radius: 5px;

						font-weight: bold;

						transition:
						transform 0.2s,
						background 0.2s;
						}


						.button:hover {
						transform:
						translateY(-2px);
						}


						.primary-button {
						background: white;

						color: #080a0d;
						}


						.primary-button:hover {
						background: #d9d9d9;
						}


						.secondary-button {
						background: #15181d;

						border:
						1px solid #383d45;
						}


						.secondary-button:hover {
						background: #20242b;
						}



						/* =====================================================
						PROJECT SECTION
						===================================================== */

						#projects {
						padding:
						100px 0 140px;
						}


						.section-label {
						color: #858c96;

						font-size: 12px;

						font-weight: bold;

						letter-spacing: 4px;

						margin-bottom: 10px;
						}


						.section-title {
						font-size:
						clamp(
						38px,
						6vw,
						55px
						);

						margin-bottom: 15px;
						}


						.section-description {
						max-width: 700px;

						margin-bottom: 45px;

						color: #9fa5ae;
						}



						/* =====================================================
						PROJECT CARDS
						===================================================== */

						.project-grid {
						display: grid;

						grid-template-columns:
						repeat(
						3,
						1fr
						);

						gap: 22px;

						align-items: start;
						}


						.project-card {
						background:
						rgba(
						18,
						21,
						26,
						0.92
						);

						border:
						1px solid #2b3038;

						border-radius: 8px;

						overflow: hidden;

						transition:
						border-color 0.2s,
						transform 0.2s;
						}


						.project-card:hover {
						border-color: #525a66;

						transform:
						translateY(-4px);
						}


						.project-main {
						padding: 25px;
						}


						.project-engine {
						margin-bottom: 8px;

						color: #7f8791;

						font-size: 11px;

						font-weight: bold;

						letter-spacing: 2px;
						}


						.project-main h3 {
						margin-bottom: 5px;

						font-size: 26px;
						}


						.project-tech {
						margin-bottom: 15px;

						color: #828994;

						font-size: 13px;
						}


						.project-description {
						min-height: 95px;

						color: #b5bac1;

						font-size: 15px;
						}



						/* =====================================================
						PROJECT DROPDOWNS
						===================================================== */

						details {
						border-top:
						1px solid #2b3038;
						}


						summary {
						padding:
						16px 25px;

						cursor: pointer;

						list-style: none;

						font-weight: bold;

						font-size: 14px;

						background:
						rgba(
						11,
						13,
						17,
						0.65
						);
						}


						summary::-webkit-details-marker {
						display: none;
						}


						summary::after {
						content: "+";

						float: right;

						color: #888f99;

						font-size: 18px;
						}


						details[open] summary::after {
						content: "−";
						}


						summary:hover {
						background: #171a20;
						}


						.dropdown-content {
						padding:
						20px 25px 25px;

						color: #aeb3ba;

						border-top:
						1px solid #252a31;
						}


						.dropdown-content p {
						margin-bottom: 10px;
						}


						.dropdown-content p:last-child {
						margin-bottom: 0;
						}



						/* =====================================================
						FOOTER
						===================================================== */

						footer {
						padding:
						35px 20px;

						text-align: center;

						color: #666d76;

						border-top:
						1px solid #24282f;
						}



						/* =====================================================
						MOBILE
						===================================================== */

						@media (max-width: 850px) {

						.project-grid {
						grid-template-columns:
						1fr;
						}


						.project-description {
						min-height: auto;
						}

						}


						@media (max-width: 600px) {

						.nav-links {
						display: none;
						}


						.hero h1 {
						font-size: 55px;

						letter-spacing: -2px;
						}


						.hero-buttons {
						flex-direction: column;

						align-items: flex-start;
						}

						}

					</style>

				</head>



	<body>


		<!-- =====================================================
         STAR BACKGROUND
    ====================================================== -->

		<div id="stars"></div>



		<!-- =====================================================
         NAVIGATION
    ====================================================== -->

		<header>

			<nav>

				<a
					href="#home"
					class="logo"
            >
					Josh Maddox
				</a>


				<div class="nav-links">

					<a href="#home">
						Home
					</a>

					<a href="#projects">
						Projects
					</a>

				</div>

			</nav>

		</header>



		<main>


			<!-- =================================================
